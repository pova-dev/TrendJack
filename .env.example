# TrendJack environment template. Copy to .env.local and fill values.

# --- Database ----------------------------------------------------------------
# MVP defaults to SQLite. For Postgres, change schema.prisma `provider` to
# "postgresql" and set this to your connection string.
DATABASE_URL="file:./dev.db"

# --- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Slack -------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#trendjack-drafts

# --- Google Sheets (service account) ----------------------------------------
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
TRENDJACK_SHEET_ID=

# --- Generic outbound webhook (Notion / Airtable / Linear / custom) ---------
TRENDJACK_DEFAULT_WEBHOOK=

# --- Live connectors --------------------------------------------------------
X_BEARER_TOKEN=
REDDIT_USER_AGENT=
YOUTUBE_API_KEY=
# TIKTOK_API_KEY removed 2026-05-29 — never read in code. TikTok runs through
# RSSHub only; use RSSHUB_BASE/RSSHUB_FEEDS to configure.

# --- Cron auth (REQUIRED in production) -------------------------------------
# Set ONE of these. /api/cron-tick refuses to run in prod if both are unset.
# CRON_SECRET=               # used by Vercel Cron's Authorization: Bearer ...
# TJ_CRON_TOKEN=             # self-hosters: pass as ?token=... query param

# --- Email for delete confirmation codes (REQUIRED to delete anything) ------
# Admins and owners must enter a code from their email before a delete goes
# through. Without these four set, /api/auth/otp returns 503 and deleting is
# impossible — that is deliberate, not a failure to handle the case.
#
# SMTP_PORT drives TLS: 465 is implicit TLS, 587 upgrades via STARTTLS. Leave
# SMTP_SECURE unset unless your provider needs it forced.
#
# Google Workspace note: SMTP_PASS must be an App Password, not the account
# password, and 2-Step Verification has to be on for the account first.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=trendjack@yourcompany.com
# SMTP_PASS=
# MAIL_FROM=TrendJack <trendjack@yourcompany.com>

# --- Worker -----------------------------------------------------------------
TRENDJACK_BASE_URL=http://localhost:3000
